{
  "name": "dcuobot-bot",
  "version": "0.0.0",
  "description": "DCUOBot NodeJS Discord bot",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx --env-file=.env src/index.ts",
    "dev": "tsx --env-file=.env watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DCUOBot/dcuobot-bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DCUOBot/dcuobot-bot/issues"
  },
  "homepage": "https://github.com/DCUOBot/dcuobot-bot#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "discord.js": "^14.27.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
